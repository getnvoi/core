{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "nvoi",
  "uid": "nvoi",
  "tags": ["nvoi"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": "Prometheus",
        "query": "label_values(kube_deployment_spec_replicas{namespace=\"default\"}, deployment)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Cluster", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false },

    {
      "type": "stat",
      "title": "Nodes Ready",
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4},
      "targets": [{"expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Pods Running",
      "datasource": "Prometheus",
      "gridPos": {"x": 6, "y": 1, "w": 6, "h": 4},
      "targets": [{"expr": "sum(kube_pod_status_phase{phase=\"Running\"})", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Deployments ready",
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 1, "w": 6, "h": 4},
      "targets": [{"expr": "sum(kube_deployment_status_replicas_ready{namespace=\"default\"})", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Restarts (1h)",
      "datasource": "Prometheus",
      "gridPos": {"x": 18, "y": 1, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"default\"}[1h]))", "refId": "A"}]
    },

    {
      "type": "timeseries",
      "title": "Node CPU usage",
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (instance, mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))", "refId": "A", "legendFormat": "{{instance}} {{mode}}"}]
    },
    {
      "type": "timeseries",
      "title": "Node memory used (fraction)",
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
      "targets": [{"expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A", "legendFormat": "{{instance}}"}]
    },

    { "type": "row", "title": "Service: $service", "gridPos": {"x": 0, "y": 13, "w": 24, "h": 1}, "collapsed": false, "repeat": null },

    {
      "type": "timeseries",
      "title": "$service — replicas",
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 6},
      "targets": [
        {"expr": "kube_deployment_status_replicas_ready{namespace=\"default\",deployment=\"$service\"}", "refId": "A", "legendFormat": "ready"},
        {"expr": "kube_deployment_spec_replicas{namespace=\"default\",deployment=\"$service\"}", "refId": "B", "legendFormat": "desired"}
      ]
    },
    {
      "type": "timeseries",
      "title": "$service — restart rate",
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 6},
      "targets": [{"expr": "rate(kube_pod_container_status_restarts_total{namespace=\"default\",pod=~\"$service-.*\"}[5m])", "refId": "A", "legendFormat": "{{pod}}"}]
    },
    {
      "type": "timeseries",
      "title": "$service — CPU",
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6},
      "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"default\",pod=~\"$service-.*\"}[5m]))", "refId": "A", "legendFormat": "{{pod}}"}]
    },
    {
      "type": "timeseries",
      "title": "$service — memory",
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 6},
      "targets": [{"expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"default\",pod=~\"$service-.*\"})", "refId": "A", "legendFormat": "{{pod}}"}]
    },
    {
      "type": "logs",
      "title": "$service — logs",
      "datasource": "Loki",
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 12},
      "targets": [{"expr": "{namespace=\"default\", service=\"$service\"}", "refId": "A"}]
    }
  ]
}
