provider "hcloud" {}

locals {
  app    = {{ .App | hcl }}
  env    = {{ .Env | hcl }}
  prefix = {{ .Prefix | hcl }}
}

# ── Private network ────────────────────────────────────────────────────

resource "hcloud_network" "default" {
  name     = "${local.prefix}-net"
  ip_range = {{ .NetworkCIDR | hcl }}
  labels = {
    nvoi_app = local.app
    nvoi_env = local.env
  }
}

resource "hcloud_network_subnet" "default" {
  network_id   = hcloud_network.default.id
  type         = "cloud"
  network_zone = {{ .NetworkZone | hcl }}
  ip_range     = {{ .NetworkSubnet | hcl }}
}

# ── Firewall ───────────────────────────────────────────────────────────
# All-tunnel mode: SSH (22) is the only public ingress. HTTP/S ingress
# enters via Cloudflare's edge, terminates at CF, rides an outbound
# tunnel into the cluster. Cluster control-plane + kubelet + flannel +
# registry are private-only.

resource "hcloud_firewall" "default" {
  name = "${local.prefix}-fw"
  labels = {
    nvoi_app = local.app
    nvoi_env = local.env
  }

  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "22"
    source_ips = ["0.0.0.0/0", "::/0"]
  }
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "6443"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "10250"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
  rule {
    direction  = "in"
    protocol   = "udp"
    port       = "8472"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "5000"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
}

# ── Servers ────────────────────────────────────────────────────────────
# Network attachment uses the dedicated `hcloud_server_network` resource
# (not the inline `network { }` block on `hcloud_server`). The inline
# block is deprecated by hetznercloud/hcloud >=1.50 — it leaks both
# `network_id` and `subnet_id` into state and trips a `ConflictsWith`
# validator on every subsequent refresh, breaking destroy. The separate
# resource is the upstream-recommended shape.
{{ range .Servers }}
resource "hcloud_server" {{ .Key | hcl }} {
  name         = {{ .Hostname | hcl }}
  server_type  = {{ .Type | hcl }}
  image        = {{ .Image | hcl }}
  location     = {{ .Region | hcl }}
  user_data    = {{ .UserData | hcl }}
  firewall_ids = [hcloud_firewall.default.id]

  labels = {
    nvoi_app  = local.app
    nvoi_env  = local.env
    nvoi_role = {{ .Role | hcl }}
  }

  lifecycle {
    # user_data: ForceNew + the hcloud provider's stored hash isn't always
    # stable across reads. Without this, every plan that produces a slightly
    # different bytewise user_data would trigger a server replacement —
    # destroying the running cluster on a no-op cosmetic change. Cloud-init
    # only runs at first boot anyway, so changing user_data has no semantic
    # effect on a running server.
    ignore_changes = [user_data]
  }
}

resource "hcloud_server_network" {{ .Key | hcl }} {
  server_id = hcloud_server.{{ .Key }}.id
  subnet_id = hcloud_network_subnet.default.id
}
{{ end }}
{{ if .HA }}
# ── Apiserver HA load balancer ─────────────────────────────────────────
# Private-only hcloud LB on 6443 fronting the master pool. Only emitted
# when `ha: true` in YAML; single-master clusters skip this entirely.
#
# Why an LB on Hetzner (not kube-vip ARP): Hetzner Cloud private
# networks are software-defined and L3-routed — the cloud router only
# forwards packets to IPs registered to specific server NICs via the
# Hetzner API. A self-assigned VIP via ARP is silently black-holed by
# the routing fabric. The LB is a first-class Hetzner resource that
# the router knows how to route, so traffic from workers / secondary
# masters reliably reaches whichever healthy master the LB picks.
#
# Public interface is DISABLED — the LB is reachable ONLY from the
# private subnet. Public-internet HTTP/S ingress still flows exclusively
# through the cloudflared egress tunnel.

resource "hcloud_load_balancer" "cp" {
  name               = "${local.prefix}-cp"
  load_balancer_type = "lb11"
  network_zone       = {{ .NetworkZone | hcl }}
  labels = {
    nvoi_app = local.app
    nvoi_env = local.env
  }
}

resource "hcloud_load_balancer_network" "cp" {
  load_balancer_id        = hcloud_load_balancer.cp.id
  subnet_id               = hcloud_network_subnet.default.id
  enable_public_interface = false
}

resource "hcloud_load_balancer_target" "cp" {
  type             = "label_selector"
  load_balancer_id = hcloud_load_balancer.cp.id
  label_selector   = "nvoi_app=${local.app},nvoi_env=${local.env},nvoi_role=master"
  use_private_ip   = true
  depends_on       = [hcloud_load_balancer_network.cp]
}

resource "hcloud_load_balancer_service" "cp" {
  load_balancer_id = hcloud_load_balancer.cp.id
  protocol         = "tcp"
  listen_port      = 6443
  destination_port = 6443

  # Tighter than Hetzner's default (interval=15s, retries=3 → ~45s to
  # mark a target healthy/unhealthy). With 5×2 we converge in ~10s,
  # which matters during scale events: a fresh master joins the pool
  # ~30s sooner, and a doomed master gets declassified ~30s sooner so
  # the LB stops sending traffic to it during tofu destroy.
  health_check {
    protocol = "tcp"
    port     = 6443
    interval = 5
    timeout  = 4
    retries  = 2
  }
}
{{ end }}

# ── Outputs ────────────────────────────────────────────────────────────
# Uniform schema across providers — runner.Endpoints parses this.

output "servers" {
  value = {
{{- range .Servers }}
    {{ .Key | hcl }} = {
      role    = {{ .Role | hcl }}
      ipv4    = hcloud_server.{{ .Key }}.ipv4_address
      private = hcloud_server_network.{{ .Key }}.ip
    }
{{- end }}
  }
}

output "api_endpoint" {
  value = {
    # Public is the primary master's public IPv4 — operators reach the
    # apiserver via SSH tunnel through this address. Worker / kubelet
    # traffic never goes through it.
    public  = hcloud_server.{{ .PrimaryMaster }}.ipv4_address
    # Private API endpoint:
    #   .HA   → hcloud LB private IP. Workers + secondary masters dial
    #           this; the LB health-checks each master and steers
    #           around dead ones in ~10s.
    #   else  → primary master's private IP (single master path).
    private = {{ if .HA }}hcloud_load_balancer_network.cp.ip{{ else }}hcloud_server_network.{{ .PrimaryMaster }}.ip{{ end }}
  }
}

output "ha" {
  value = {{ if .HA }}true{{ else }}false{{ end }}
}
