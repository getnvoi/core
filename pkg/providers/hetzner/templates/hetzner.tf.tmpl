provider "hcloud" {}

locals {
  app    = {{ .App | hcl }}
  env    = {{ .Env | hcl }}
  prefix = {{ .Prefix | hcl }}
}

# ── Private network ────────────────────────────────────────────────────

resource "hcloud_network" "default" {
  name     = "${local.prefix}-net"
  ip_range = {{ .NetworkCIDR | hcl }}
  labels = {
    nvoi_app = local.app
    nvoi_env = local.env
  }
}

resource "hcloud_network_subnet" "default" {
  network_id   = hcloud_network.default.id
  type         = "cloud"
  network_zone = {{ .NetworkZone | hcl }}
  ip_range     = {{ .NetworkSubnet | hcl }}
}

# ── Firewall ───────────────────────────────────────────────────────────
# Baseline rules: SSH public, k3s control-plane + kubelet + flannel + registry private.

resource "hcloud_firewall" "default" {
  name = "${local.prefix}-fw"
  labels = {
    nvoi_app = local.app
    nvoi_env = local.env
  }

  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "22"
    source_ips = ["0.0.0.0/0", "::/0"]
  }
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "6443"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "10250"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
  rule {
    direction  = "in"
    protocol   = "udp"
    port       = "8472"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "5000"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
{{ if .PublicHTTPIngress }}
  # Single-master + domains: the master IS the public face for HTTP/S.
  # Traefik (k3s default ingress controller) holds hostPort 80/443 on
  # the master via klipper-lb; firewall opens those ports to the world.
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "80"
    source_ips = ["0.0.0.0/0", "::/0"]
  }
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "443"
    source_ips = ["0.0.0.0/0", "::/0"]
  }
{{ end }}
{{ if .LBHTTPIngress }}
  # HA + domains: public traffic enters the cloud LB (which has a public
  # IPv4) and is dispatched across masters via private network. Masters
  # only need 80/443 reachable from the private subnet — no public
  # exposure beyond SSH.
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "80"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "443"
    source_ips = [{{ .NetworkCIDR | hcl }}]
  }
{{ end }}
}

# ── Servers ────────────────────────────────────────────────────────────
{{ range .Servers }}
resource "hcloud_server" {{ .Key | hcl }} {
  name         = {{ .Hostname | hcl }}
  server_type  = {{ .Type | hcl }}
  image        = {{ .Image | hcl }}
  location     = {{ .Region | hcl }}
  user_data    = {{ .UserData | hcl }}
  firewall_ids = [hcloud_firewall.default.id]

  network {
    network_id = hcloud_network.default.id
  }

  labels = {
    nvoi_app  = local.app
    nvoi_env  = local.env
    nvoi_role = {{ .Role | hcl }}
  }

  depends_on = [hcloud_network_subnet.default]

  lifecycle {
    # user_data: ForceNew + the hcloud provider's stored hash isn't always
    #   stable across reads. Without this, every plan that produces a slightly
    #   different bytewise user_data would trigger a server replacement —
    #   destroying the running cluster on a no-op cosmetic change. Cloud-init
    #   only runs at first boot anyway, so changing user_data has no semantic
    #   effect on a running server.
    # network: hcloud provider has a Set-hashing quirk on the inline `network`
    #   block — state stores computed fields (ip, mac_address) that config
    #   doesn't have, and terraform reports drift on every plan. The actual
    #   attachment is stable; ignoring drift keeps applies idempotent.
    ignore_changes = [user_data, network]
  }
}
{{ end }}
{{ if .HA }}
# ── HA load balancer ───────────────────────────────────────────────────
# Auto-emitted because Servers has ≥2 masters.
#
# Two faces:
#   - 6443 (always): k3s API for cluster-internal joins. Workers and
#     secondary masters point at the LB private IP. Stays reachable
#     even after the originally-primary master dies.
#   - 80 + 443 (only when LBHTTPIngress, i.e. domains set): public
#     HTTPS ingress, TCP pass-through. Traefik on each master answers
#     via klipper-lb hostPort. cert-manager-issued certs come from a
#     k8s Secret each Traefik replica reads — no replication issue.
#
# Without domains: LB has no public IPv4 (disable_public_interface =
# true). The cluster still has zero public ingress beyond SSH on
# masters.

resource "hcloud_load_balancer" "cp" {
  name               = "${local.prefix}-cp"
  load_balancer_type = "lb11"
  network_zone       = {{ .NetworkZone | hcl }}
  labels = {
    nvoi_app = local.app
    nvoi_env = local.env
  }
}

resource "hcloud_load_balancer_network" "cp" {
  load_balancer_id        = hcloud_load_balancer.cp.id
  subnet_id               = hcloud_network_subnet.default.id
{{ if not .LBHTTPIngress }}
  enable_public_interface = false
{{- end }}
}

resource "hcloud_load_balancer_target" "cp" {
  type             = "label_selector"
  load_balancer_id = hcloud_load_balancer.cp.id
  label_selector   = "nvoi_app=${local.app},nvoi_env=${local.env},nvoi_role=master"
  use_private_ip   = true
  depends_on       = [hcloud_load_balancer_network.cp]
}

resource "hcloud_load_balancer_service" "cp" {
  load_balancer_id = hcloud_load_balancer.cp.id
  protocol         = "tcp"
  listen_port      = 6443
  destination_port = 6443

  # Tighter than Hetzner's default (interval=15s, retries=3 → ~45s to
  # mark a target healthy/unhealthy). With 5×2 we converge in ~10s,
  # which matters during scale events: a fresh master joins the pool
  # ~30s sooner, and a doomed master gets declassified ~30s sooner so
  # the LB stops sending traffic to it during tofu destroy.
  health_check {
    protocol = "tcp"
    port     = 6443
    interval = 5
    timeout  = 4
    retries  = 2
  }
}
{{ if .LBHTTPIngress }}
resource "hcloud_load_balancer_service" "http" {
  load_balancer_id = hcloud_load_balancer.cp.id
  protocol         = "tcp"
  listen_port      = 80
  destination_port = 80

  health_check {
    protocol = "tcp"
    port     = 80
    interval = 5
    timeout  = 4
    retries  = 2
  }
}

resource "hcloud_load_balancer_service" "https" {
  load_balancer_id = hcloud_load_balancer.cp.id
  protocol         = "tcp"
  listen_port      = 443
  destination_port = 443

  health_check {
    protocol = "tcp"
    port     = 443
    interval = 5
    timeout  = 4
    retries  = 2
  }
}
{{ end }}
{{ end }}

# ── Outputs ────────────────────────────────────────────────────────────
# Uniform schema across providers — runner.Endpoints parses this.

output "servers" {
  value = {
{{- range .Servers }}
    {{ .Key | hcl }} = {
      role    = {{ .Role | hcl }}
      ipv4    = hcloud_server.{{ .Key }}.ipv4_address
      private = one([for n in hcloud_server.{{ .Key }}.network : n.ip])
    }
{{- end }}
  }
}

output "api_endpoint" {
  value = {
    public  = {{ if .LBHTTPIngress }}hcloud_load_balancer.cp.ipv4{{ else }}hcloud_server.{{ .PrimaryMaster }}.ipv4_address{{ end }}
    private = {{ if .HA }}hcloud_load_balancer_network.cp.ip{{ else }}one([for n in hcloud_server.{{ .PrimaryMaster }}.network : n.ip]){{ end }}
  }
}

output "ha" {
  value = {{ if .HA }}true{{ else }}false{{ end }}
}
