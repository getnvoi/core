# Provider auth: CLOUDFLARE_API_TOKEN env var (set by cmd/cli at the
# boundary from the operator's CF_API_KEY). Keeping the token out of
# the .tf file means it doesn't land in tfstate.
#
# The required_providers + version pin live in the consolidated
# backend.tf rendered by internal/compile — terraform requires
# `required_providers` to appear exactly once per module.
provider "cloudflare" {}

locals {
  cloudflare_zone_id = {{ .ZoneID | hcl }}
}

# ── DNS records ────────────────────────────────────────────────────────
# A record per (service, domain) → master public IPv4
# (terraform-resolved from hcloud_server.<primary>.ipv4_address).
# proxied=false leaves CF's orange-cloud off; flip to true at the
# Cloudflare zone level if you want CF in front.
{{ range .Records }}
resource "cloudflare_record" {{ .ResourceName | hcl }} {
  zone_id = local.cloudflare_zone_id
  name    = {{ .Name | hcl }}
  type    = "A"
  content = {{ .Target }}
  proxied = false
  ttl     = 1
}
{{ end }}
