# Cloudflare DNS + tunnel emission. Renders into the
# cloudflare-dns.tf bundle entry whenever cfg.Domains is non-empty.
# The provider-config block lives here; required_providers + the
# version pin live in the consolidated backend.tf rendered by
# internal/compile.
provider "cloudflare" {}

locals {
  cloudflare_account_id = {{ .AccountID | hcl }}
  cloudflare_zone_id    = {{ .ZoneID | hcl }}
  tunnel_name           = {{ .TunnelName | hcl }}
}

# ── The tunnel itself ──────────────────────────────────────────────────
# Named after app+env so re-running `nvoi deploy` is idempotent — the
# same name on a second deploy adopts the existing tunnel (CF tunnel
# names are unique per account).
#
# `secret` is operator-supplied (CF_TUNNEL_SECRET), baked as a literal
# at compile time. cloudflare provider 4.x marks `secret` Required;
# we don't mint it via random_id — keeps the trust surface explicit,
# avoids hashicorp/random in state, makes secret rotation an operator
# decision (regenerate, swap env, redeploy) rather than a state taint.
resource "cloudflare_zero_trust_tunnel_cloudflared" "main" {
  account_id = local.cloudflare_account_id
  name       = local.tunnel_name
  secret     = {{ .TunnelSecret | hcl }}
}

# ── Tunnel ingress configuration ───────────────────────────────────────
# One rule per (service, domain). Order matters — cloudflared matches
# the first rule whose hostname matches; the final catch-all 404 is
# required by the cloudflared schema.
resource "cloudflare_zero_trust_tunnel_cloudflared_config" "main" {
  account_id = local.cloudflare_account_id
  tunnel_id  = cloudflare_zero_trust_tunnel_cloudflared.main.id

  config {
{{ range .Routes }}
    ingress_rule {
      hostname = {{ .Hostname | hcl }}
      service  = {{ .Service | hcl }}
    }
{{ end }}
    ingress_rule {
      service = "http_status:404"
    }
  }
}

# ── CNAME records per domain ───────────────────────────────────────────
# Point each domain at the tunnel's per-account CNAME target. CF's
# edge routes <uuid>.cfargotunnel.com to the matching tunnel ID
# automatically. proxied=true enables CF edge TLS termination — the
# whole point of tunnel mode is delegating TLS to CF, so the orange
# cloud is mandatory here (in contrast to Traefik-mode A records where
# Traefik holds the cert in-cluster and we set proxied=false).
{{ range .Records }}
resource "cloudflare_record" {{ .ResourceName | hcl }} {
  zone_id = local.cloudflare_zone_id
  name    = {{ .Name | hcl }}
  type    = "CNAME"
  content = "${cloudflare_zero_trust_tunnel_cloudflared.main.cname}"
  proxied = true
  ttl     = 1
}
{{ end }}

# ── Outputs ────────────────────────────────────────────────────────────
# Token is the base64-encoded JSON blob cloudflared consumes via
# `--token`. nvoi reads this post-apply and lands it in a k8s Secret
# under owner=tunnel. Sensitive so it never lands in plain `tofu
# output` dumps (operators can `tofu output -raw tunnel.token` when
# debugging).
output "tunnel" {
  sensitive = true
  value = {
    id    = cloudflare_zero_trust_tunnel_cloudflared.main.id
    cname = cloudflare_zero_trust_tunnel_cloudflared.main.cname
    token = cloudflare_zero_trust_tunnel_cloudflared.main.tunnel_token
  }
}
