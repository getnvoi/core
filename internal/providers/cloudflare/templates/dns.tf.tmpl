# Provider auth: CLOUDFLARE_API_TOKEN env var (set by cmd/cli at the
# boundary from the operator's CF_API_KEY). Keeping the token out of
# the .tf file means it doesn't land in tfstate.
#
# The required_providers + version pin live in the consolidated
# backend.tf rendered by internal/compile — terraform requires
# `required_providers` to appear exactly once per module.
provider "cloudflare" {}

locals {
  cloudflare_zone_id = {{ .ZoneID | hcl }}
}

# ── DNS records ────────────────────────────────────────────────────────
# Without providers.tunnel: A record per (service, domain) → master
# public IPv4 (terraform-resolved from hcloud_server.<primary>.ipv4_address).
# With providers.tunnel: CNAME record → local.tunnel_cname (defined by
# the tunnel emitter; cloudflare → <tunnel-id>.cfargotunnel.com,
# ngrok → reserved-domain CNAME). The tunnel emitter also exposes
# local.tunnel_proxied so CF orange-cloud flips on for cloudflare
# tunnels (required for cfargotunnel routing).
{{ range .Records }}
resource "cloudflare_record" {{ .ResourceName | hcl }} {
  zone_id = local.cloudflare_zone_id
  name    = {{ .Name | hcl }}
{{- if .Tunnel }}
  type    = "CNAME"
  content = local.tunnel_cname
  proxied = local.tunnel_proxied
{{- else }}
  type    = "A"
  content = {{ .Target }}
  proxied = false
{{- end }}
  ttl     = 1
}
{{ end }}
