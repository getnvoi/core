#!/bin/sh
# Writes the installation's secrets into <dir>, one file each, mode 600: random hex, made once. A file that exists is
# kept, so a second run changes nothing. The server reads them there through NVOI_SECRETS (Nvoi.Credentials: a
# secret's file is its variable's name in lower case). Prints the names it made or kept, never a value.
#
#   bin/secrets /secrets
set -eu

dir="${1:?usage: bin/secrets <dir>}"
mkdir -p "$dir"
umask 077

# <name> <bytes>
make() {
  if [ -e "$dir/$1" ]; then
    echo "$1 kept"
    return
  fi
  openssl rand -hex "$2" >"$dir/.$1.new"
  # mv -n never replaces a file another run wrote meanwhile.
  mv -n "$dir/.$1.new" "$dir/$1"
  rm -f "$dir/.$1.new"
  echo "$1 made"
}

make secret_key_base 64
make encryption_primary_key 32
make encryption_key_derivation_salt 32
make gate_jwt_secret 32
make forgejo_password 24
make postgres_password 24
