{
  "name": "seed",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/app.ts",
    "jobs": "tsx watch --clear-screen=false server/worker.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production node --experimental-strip-types server/app.ts",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-router/express": "^7.10.0",
    "@react-router/node": "^7.10.0",
    "@tailwindcss/vite": "^4.1.18",
    "bcryptjs": "^3.0.3",
    "pg": "^8.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "drizzle-orm": "^0.44.6",
    "express": "^4.21.2",
    "isbot": "^5.1.31",
    "lucide-react": "^0.562.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.69.0",
    "react-router": "^7.10.0",
    "pg-boss": "^10.1.5",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.18.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/ui": "^4.0.16",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.2",
    "happy-dom": "^20.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16"
  }
}
