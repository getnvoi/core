# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# ORDER IS MEANING IN THIS FILE. A later pattern wins, so every `!` negation has
# to come AFTER the pattern it re-includes. Sorting these lines alphabetically —
# which is what happened to this file once — puts `!/app/assets/builds/.keep`
# above `/app/assets/builds/*` and silently drops the `.keep` from the index.
#
# The seed is packed with `git ls-files --cached --others --exclude-standard`, so
# a directory that exists only because of its `.keep` then never reaches anybody's
# checkout at all.
#
# If you need to ignore files created by your editor/tools, consider using a
# global .gitignore or ~/.config/git/ignore.

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# THE STYLESHEET IS BUILT, NEVER COMMITTED. `bin/rails tailwindcss:build` runs in
# setup and the `css` process rewrites it on every template change; a copy in git
# would be stale from the first edit.
/app/assets/builds/*
!/app/assets/builds/.keep

# Temporary files generated by your text editor or operating system
.DS_Store
