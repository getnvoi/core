{
  "name": "video",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "render": "remotion render src/index.ts Main out/video.mp4 --props=./props.json",
    "poster": "remotion still src/index.ts Main out/poster.png --props=./props.json --frame=0"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/player": "4.0.532",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.0",
    "@types/react-dom": "^19.1.0"
  }
}
