# syntax=docker/dockerfile:1
# The `-previews` image: wrangler, the preview worker (packages/core/worker/sandboxes) and the script that deploys it
# (previews). compose.yml's `previews` service runs it once. Built from the repository root:
# `docker buildx build -f packages/selfhosted/Dockerfile.previews .`.
FROM node:22-bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends curl jq ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# The wrangler that deploys the worker, pinned.
RUN npm install -g --no-audit --no-fund wrangler@4.148.0
WORKDIR /previews/worker
COPY packages/core/worker/sandboxes/package.json packages/core/worker/sandboxes/wrangler.toml ./
COPY packages/core/worker/sandboxes/index.ts packages/core/worker/sandboxes/gate.ts packages/core/worker/sandboxes/shell.ts ./
RUN npm install --omit=dev --no-audit --no-fund
COPY packages/selfhosted/previews /usr/local/bin/previews
ENV WRANGLER_SEND_METRICS=false
CMD ["previews"]
